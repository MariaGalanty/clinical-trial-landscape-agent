# Copy this file to .env and fill in your own values.
# DO NOT ADD .env TO VERSION CONTROL.

OPENAI_API_KEY=your-openai-key        # summariser and agent (LLM calls)
TAVILY_API_KEY=your-tavily-key        # web search and page extract for the agent
NCBI_EMAIL=you@example.com            # sent with PubMed requests, as NCBI asks
